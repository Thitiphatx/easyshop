generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model AuthMe {
  id           Int                 @id @default(autoincrement()) @db.UnsignedMediumInt
  username     String              @unique(map: "username") @db.VarChar(255)
  realname     String              @db.VarChar(255)
  password     String              @db.VarChar(255)
  ip           String?             @db.VarChar(40)
  lastlogin    BigInt?
  x            Float               @default(0)
  y            Float               @default(0)
  z            Float               @default(0)
  world        String              @default("world") @db.VarChar(255)
  regdate      BigInt              @default(0)
  regip        String?             @db.VarChar(40)
  yaw          Float?              @db.Float
  pitch        Float?              @db.Float
  email        String?             @db.VarChar(255)
  isLogged     Int                 @default(0) @db.SmallInt
  hasSession   Int                 @default(0) @db.SmallInt
  totp         String?             @db.VarChar(32)
  isAdmin      Int                 @default(0) @db.SmallInt
  uuid         String              @db.VarChar(36)
  playerPoints playerpoints_points @relation(fields: [uuid], references: [uuid])
  topups       Topup[]
  transactions Transaction[]

  @@index([uuid])
  @@map("authme")
}

model Server {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(25)
  subtitle     String?       @db.VarChar(25)
  imageUrl     String?       @db.Text
  rconHost     String        @db.VarChar(255)
  rconPort     String        @db.VarChar(5)
  rconPassword String        @db.VarChar(255)
  items        Item[]
  transactions Transaction[]

  @@map("server")
}

model Item {
  id            Int           @id @default(autoincrement())
  serverId      Int
  name          String        @db.VarChar(50)
  description   String        @db.Text
  imageUrl      String?       @db.Text
  command       String        @db.Text
  price         Int           @default(0)
  category      String        @db.VarChar(25)
  createdAt     DateTime      @default(now())
  lastUpdatedAt DateTime      @default(now()) @updatedAt
  isAvailable   Boolean       @default(false)
  server        Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([serverId])
  @@map("item")
}

model Transaction {
  id              Int      @id @default(autoincrement())
  username        String   @db.VarChar(255)
  itemId          Int
  serverId        Int
  pricePaid       Int
  executedCommand String   @db.VarChar(255)
  createdAt       DateTime @default(now())
  item            Item     @relation(fields: [itemId], references: [id])
  server          Server   @relation(fields: [serverId], references: [id])
  user            AuthMe   @relation(fields: [username], references: [username], onDelete: Cascade)

  @@index([username])
  @@index([itemId])
  @@index([serverId])
  @@map("transaction")
}

model Topup {
  id          Int         @id @default(autoincrement())
  userId      Int         @db.UnsignedMediumInt
  amount      Float
  pointsAdded Int
  channel     String      @db.VarChar(50)
  status      TopupStatus @default(SUCCESS)
  reference   String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  user        AuthMe      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("topup")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model playerpoints_migrations {
  migration_version Int

  @@ignore
}

model playerpoints_points {
  id      Int      @id @default(autoincrement())
  uuid    String   @unique(map: "uuid") @db.VarChar(36)
  points  Int      @default(0)
  authMes AuthMe[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model playerpoints_transaction_log {
  transaction_type String    @db.VarChar(20)
  description      String    @db.VarChar(100)
  source           String?   @db.VarChar(36)
  receiver         String    @db.VarChar(36)
  amount           Int
  timestamp        DateTime? @default(now()) @db.Timestamp(0)

  @@ignore
}

model playerpoints_username_cache {
  uuid     String @unique(map: "uuid") @db.VarChar(36)
  username String @db.VarChar(30)

  @@index([username], map: "playerpoints_username_cache_username_index")
  @@index([uuid], map: "playerpoints_username_cache_uuid_index")
}

enum TopupStatus {
  PENDING
  SUCCESS
  FAILED
}

model Setting {
  id                    Int     @id @default(autoincrement())
  siteName              String  @db.VarChar(255)
  siteDesc              String? @db.Text
  logo                  String? @db.VarChar(255)
  serverIp              String  @db.VarChar(15)
  serverImageUrl        String? @db.VarChar(255)
  serverName            String  @db.VarChar(255)
  serverDesc            String? @db.Text
  pointMultiplier       Float   @default(1)
  enableTruewallet      Boolean @default(false)
  enableBank            Boolean @default(false)
  easyslipApiKey        String? @db.VarChar(255)
  truewalletPhoneNumber String  @db.VarChar(255)

  @@map("setting")
}

model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @db.VarChar(255)
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("banner")
}
